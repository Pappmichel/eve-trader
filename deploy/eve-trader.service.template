# systemd unit for the EVE Trader backend - installed by setup.sh, which
# substitutes __APP_DIR__/__APP_USER__ and writes the result to
# /etc/systemd/system/eve-trader.service. Not meant to be installed as-is.
#
# --host 127.0.0.1 (not 0.0.0.0): uvicorn is never exposed directly to the
# internet - nginx (see nginx-eve-trader.conf) is the only thing that should
# be reachable on the public interface, terminating TLS and proxying to this
# loopback-only port. WorkingDirectory matters beyond convention: config.py's
# load_dotenv() and DEFAULT_CONFIG_PATH both resolve relative to the process's
# CWD-adjacent project root, same as running `uvicorn` by hand from the repo
# root in local dev.

[Unit]
Description=EVE Trader backend (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/.venv/bin/uvicorn eve_trader.api.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

# Sandboxing. Each line has a side effect worth knowing before removing it.
# Files the service creates are group-readable at most, never world-readable
# (backups and exports are written with 0600 explicitly anyway).
UMask=0027
# No setuid/setgid escalation from inside the service.
NoNewPrivileges=yes
# The service gets a private /tmp and /var/tmp. Side effect: temp files it
# writes are invisible to deploy scripts and to other users.
PrivateTmp=yes
# /usr, /boot and /etc become read-only for the service. The app writes only
# below its own directory (data/, logs), so nothing here needs /etc.
# ProtectHome is deliberately NOT set: the repository usually lives in the
# deploy user's home directory.
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# No MemoryMax/CPUQuota on purpose: the mineral solver runs in a child
# process on a 1-CPU host and no measurement justifies a limit yet.

[Install]
WantedBy=multi-user.target
