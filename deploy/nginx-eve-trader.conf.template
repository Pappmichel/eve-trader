# nginx reverse-proxy config - installed by setup.sh, which substitutes
# __DOMAIN__ and writes the result to /etc/nginx/sites-available/eve-trader.
# Deliberately plain HTTP only (port 80) - run `certbot --nginx` afterward
# (see deploy/README.md) to add the HTTPS server block and the http->https
# redirect; certbot rewrites this file in place to do that, so there's no
# point hand-writing the TLS block here just to have certbot replace it.

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # All three user-triggered Trading HTTP jobs (Refresh Shortlist,
        # Search + Add + Clean Up, Run Complete Pipeline) return immediately
        # now (background thread + status polling, see
        # eve_trader/pipeline_runner.py) - the 300s timeout added 2026-08-23
        # for those synchronous endpoints is no longer needed. 60s is
        # nginx's own default and is enough for the remaining request-scoped
        # actions. The scheduler and CLI still call do_pipeline /
        # do_refresh_shortlist in-process (no HTTP hop).
        proxy_read_timeout 60s;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
    }
}
