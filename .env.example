# Copy to .env and fill in.
# Register an application at https://developers.eveonline.com
# - Connection type: Authorization Code (with PKCE support, "public" client is fine)
# - Callback URL must exactly match EVE_SSO_CALLBACK_HOST:EVE_SSO_CALLBACK_PORT below,
#   plus the FastAPI backend's fixed "/api/auth/callback" path -
#   e.g. http://localhost:8000/api/auth/callback (8000 = uvicorn's default port,
#   see start.bat/README - change this if you run the backend on a different port)

EVE_SSO_CLIENT_ID=your_client_id_here
EVE_SSO_CLIENT_SECRET=
EVE_SSO_CALLBACK_HOST=localhost
EVE_SSO_CALLBACK_PORT=8000
EVE_CONTACT_EMAIL=you@example.com

# Signs the access-gate session cookie (see eve_trader/access_gate.py) - only
# needed once config.yaml's access_gate_enabled is true. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Local dev only (two processes, see README's "Running the app") - where the
# browser gets redirected back to after an EVE SSO login. Leave commented out
# for local dev (the default, http://localhost:5173, is already correct).
# Once deployed behind a real domain (single-process "real run" mode, see
# deploy/README.md), set this to that same public origin, e.g.
# FRONTEND_ORIGIN=https://eve-trader.example.com
# FRONTEND_ORIGIN=http://localhost:5173

# Only needed once deployed behind HTTPS/a reverse proxy - the default
# EVE_SSO_CALLBACK_HOST/PORT construction below only ever produces a plain
# "http://host:port" URL, which won't match a real "https://domain" callback
# URL registered at developers.eveonline.com. See deploy/README.md.
# EVE_SSO_REDIRECT_URI=https://eve-trader.example.com/api/auth/callback

# Postgres connection (see eve_trader/storage.py) - the app connects as the
# non-owner eve_trader_app role (never the DB owner) so RLS can never be
# silently bypassed. Local dev default (matches the docker-based eve-trader-pg
# container, see docs/MULTI_TENANT_PLAN.md) needs no override at all; a real
# deployment needs a real generated password here, never the dev default.
# EVE_TRADER_PG_DSN=host=localhost port=5432 dbname=eve_trader user=eve_trader_app password=app_devpassword

# eve_trader/backup.py's pg_dump invocation - local dev runs Postgres in
# Docker, so the default here wraps pg_dump in `docker exec <container>`.
# On a host that runs Postgres natively (no Docker - e.g. a small VM where
# Docker's own overhead isn't worth it), set EVE_TRADER_PG_CONTAINER to the
# literal empty string to call `pg_dump` directly instead.
# EVE_TRADER_PG_CONTAINER=eve-trader-pg
# EVE_TRADER_DOCKER_BIN=docker
